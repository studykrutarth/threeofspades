# Server environment variables
# Copy to .env and fill in your own values

# Postgres connection string. For local dev, run `docker compose up -d`
# and use the default below; for production point at your own Postgres host.
DATABASE_URL="postgresql://threeofspades:threeofspades@localhost:5432/threeofspades"

# Secret used to sign/verify our own auth JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=""

# Optional
PORT=3001
